## 用于serial->系统
# received heart_beat
std_msgs/Header header
int32 battery #剩下电量     0--100
int32 life_extra #剩下生命  0--100
int32 color#装甲板颜色
int32 bullet_extra #剩余子弹 0-255
int32 fault_flag #故障指示电控方面
# additional data
bool launch
bool arm
int32 base_hp_our
int32 base_hp_enemy
int32 judge_warning
# game_data
int64 stage_remain_time
int32 game_progress

